{
  "name": "@broker-chatbot/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "sim": "tsx --env-file-if-exists=../.env src/simulator/index.ts",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "aedes": "^1.2.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "mqtt": "^5.16.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
