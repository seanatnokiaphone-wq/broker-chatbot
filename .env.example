# Anthropic API key for the chat assistant
ANTHROPIC_API_KEY=

# Broker to record. Leave unset to start an embedded broker on 1883 (handy for the mock data).
# MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Topic filter(s) to record, comma separated
MQTT_SUBSCRIBE=#

# How much history to keep, in minutes
RETENTION_MINUTES=180

# HTTP port for the API (the Vite dev server proxies /api and /ws here)
PORT=8787

# Claude model used by the assistant
CLAUDE_MODEL=claude-opus-5-5

# Optional: also write every message to InfluxDB 2.x (all four must be set to enable).
# These match the influxdb service in docker-compose.yml.
# INFLUX_URL=http://localhost:8086
# INFLUX_TOKEN=broker-chatbot-dev-token
# INFLUX_ORG=acme
# INFLUX_BUCKET=uns
# INFLUX_MEASUREMENT=uns
